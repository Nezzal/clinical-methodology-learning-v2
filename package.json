{
  "name": "clinical-methodology-learning",
  "version": "1.6.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "electron:build": "npm run build && node scripts/copy-standalone-assets.js",
    "electron:package": "electron-builder build --win --publish never",
    "electron:package:mac": "electron-builder build --mac --publish never",
    "zip": "zip -r clinical-methodology-learning.zip . -x \"node_modules/*\" \".next/*\" \".git/*\" \".env*\" \"clinical-methodology-learning.zip\" \"dist/*\" \"out/*\" \".venv/*\""
  },
  "dependencies": {
    "@google/genai": "^2.6.0",
    "@xenova/transformers": "^2.17.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.recif.methodoclinique",
    "productName": "RECIF-MethodoClinique",
    "copyright": "Copyright © 2026 RECIF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      ".next/standalone/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/.next/standalone/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Plateforme RECIF"
    }
  }
}
