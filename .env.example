# Clé API OpenRouter pour le tuteur virtuel et la génération de protocole.
# Obtenez une clé sur https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Configuration Firebase Client SDK (Utilisé par le frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# Configuration SMTP Gmail (Pour l'envoi de mails de confirmation et de notifications)
SMTP_USER=your_smtp_user_email_here@gmail.com
SMTP_PASS=your_smtp_app_password_here
NEXT_PUBLIC_ADMIN_NOTIFICATION_EMAIL=your_admin_notification_recipient_email_here@gmail.com

# Configuration LLM Local Ollama (Optionnel - Utilisé en mode local déconnecté)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:latest

# Configuration Firebase Admin SDK (Pour la validation des requêtes côté serveur)
FIREBASE_CLIENT_EMAIL=your_firebase_admin_sdk_client_email_here@your_firebase_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_firebase_private_key_content_here\n-----END PRIVATE KEY-----\n"

# Mot de passe de secours pour la connexion superviseur hors-ligne
OFFLINE_ADMIN_PASSWORD=your_offline_admin_password_here
